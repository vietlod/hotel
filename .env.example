# Hotel PMS - Environment Variables Template
# Copy to .env and fill in actual values

# ======================
# Database
# ======================
DATABASE_URL=postgresql://hotel_user:HotelPMS2026@Secure@hotel-postgres:5432/hotel_pms
POSTGRES_PASSWORD=HotelPMS2026@Secure

# ======================
# Application
# ======================
ENV=production
API_PREFIX=/api/v1
API_TITLE=Hotel PMS API
API_VERSION=0.2.0

# ======================
# Channex (Channel Manager)
# ======================
CHANNEX_API_KEY=your_channex_api_key
CHANNEX_PROPERTY_ID=your_property_id

# ======================
# TTLock (Smart Lock)
# ======================
TTLOCK_CLIENT_ID=your_ttlock_client_id
TTLOCK_CLIENT_SECRET=your_ttlock_secret
TTLOCK_ACCESS_TOKEN=

# ======================
# Telegram (Notifications)
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ======================
# Security
# ======================
SECRET_KEY=your-super-secret-key-change-in-production

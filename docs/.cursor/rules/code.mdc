### Async/Await for I/O
```python
# CORRECT: All database and external API calls are async
from sqlalchemy.ext.asyncio import AsyncSession
from fastapi import Depends

@router.get("/api/indicators")
async def list_indicators(
    db: AsyncSession = Depends(get_db),
    source: Optional[str] = None,
    limit: int = 100
) -> List[IndicatorResponse]:
    """Get indicators with optional source filter."""
    try:
        query = select(Indicator)
        if source:
            query = query.where(Indicator.source == source)
        
        result = await db.execute(query.limit(limit))
        indicators = result.scalars().all()
        return [IndicatorResponse.from_orm(ind) for ind in indicators]
    except Exception as e:
        logger.error(f"Error fetching indicators: {str(e)}")
        raise HTTPException(status_code=500, detail="Database error")
```

### Error Handling
```python
# CORRECT: Specific exception handling with proper HTTP status codes
@router.post("/api/ingest/curl")
async def ingest_curl(
    payload: CurlPayload,
    current_user: User = Depends(require_admin)
):
    """Parse and execute cURL command for data ingestion."""
    try:
        if not payload.curl_command:
            raise ValueError("cURL command cannot be empty")
        
        # Parse and execute
        result = parse_curl_and_execute(payload.curl_command)
        
        if not result:
            raise ValueError("No data returned from API")
        
        return {"status": "success", "records_imported": len(result)}
        
    except ValueError as e:
        logger.warning(f"Invalid input: {str(e)}")
        raise HTTPException(status_code=400, detail=str(e))
    except TimeoutError:
        logger.error("API request timeout")
        raise HTTPException(status_code=504, detail="API timeout")
    except Exception as e:
        logger.error(f"Unexpected error: {str(e)}", exc_info=True)
        raise HTTPException(status_code=500, detail="Internal server error")
```


### Component Architecture
```typescript
// CORRECT: Typed component with proper error boundaries
interface ResultsPanelProps {
  indicators: IndicatorResponse[];
  loading: boolean;
  error?: string;
  onExport: (format: ExportFormat) => Promise<void>;
}

export const ResultsPanel: React.FC<ResultsPanelProps> = ({
  indicators,
  loading,
  error,
  onExport
}) => {
  const [isExporting, setIsExporting] = React.useState(false);
  
  const handleExport = async (format: ExportFormat) => {
    try {
      setIsExporting(true);
      await onExport(format);
    } catch (err) {
      logger.error('Export failed', err);
    } finally {
      setIsExporting(false);
    }
  };
  
  if (error) return <ErrorBoundary message={error} />;
  if (loading) return <Skeleton />;
  
  return (
    <div className="results-panel">
      {/* Component JSX */}
    </div>
  );
};
```

### API Service Layer
```typescript
// CORRECT: Type-safe API client
class IndicatorAPI {
  private baseUrl = process.env.REACT_APP_API_URL || 'http://localhost:8000';
  
  async getIndicators(filters: FilterState): Promise<IndicatorResponse[]> {
    try {
      const params = new URLSearchParams();
      if (filters.selectedSources.length > 0) {
        params.append('sources', filters.selectedSources.join(','));
      }
      if (filters.frequency) {
        params.append('frequency', filters.frequency);
      }
      
      const response = await fetch(`${this.baseUrl}/api/indicators?${params}`);
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      
      const data: APIResponse<IndicatorResponse[]> = await response.json();
      return data.data;
    } catch (error) {
      logger.error('Failed to fetch indicators', error);
      throw new Error(error instanceof Error ? error.message : 'Unknown error');
    }
  }
}
```

## Code Organization

### File Structure
```
backend/
├── routers/          # FastAPI route handlers
├── models/           # SQLAlchemy ORM models
├── schemas/          # Pydantic request/response schemas
├── services/         # Business logic (crawl4ai, uncurl, exports)
├── utils/            # Helper functions
├── dependencies.py   # FastAPI dependencies (auth, db)
└── main.py          # FastAPI app initialization

frontend/
├── components/       # Reusable React components
├── pages/           # Page components
├── services/        # API clients
├── hooks/           # Custom React hooks
├── types.ts         # TypeScript interfaces
├── constants.ts     # Static data
└── App.tsx          # Main router
```


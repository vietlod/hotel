### Data Integrity Constraints
```python
# CORRECT: Enforce data integrity at database level
from sqlalchemy import CheckConstraint, UniqueConstraint

class ImportBatch(Base):
    __tablename__ = "import_batches"
    
    id = Column(String(36), primary_key=True)
    status = Column(String(20), default='pending')  # pending, processing, complete, failed
    imported_count = Column(Integer, default=0)
    total_count = Column(Integer, nullable=False)
    created_at = Column(DateTime, default=datetime.utcnow)
    completed_at = Column(DateTime, nullable=True)
    
    # Ensure imported_count doesn't exceed total_count
    __table_args__ = (
        CheckConstraint('imported_count <= total_count'),
        CheckConstraint('status IN (\'pending\', \'processing\', \'complete\', \'failed\')'),
    )
```

### Query Optimization
```python
# CORRECT: Use eager loading for relationships
from sqlalchemy.orm import selectinload

async def get_indicator_with_values(
    db: AsyncSession,
    indicator_id: str
) -> Optional[Indicator]:
    """Fetch indicator with all related values (avoid N+1 queries)."""
    query = (
        select(Indicator)
        .where(Indicator.id == indicator_id)
        .options(selectinload(Indicator.values))  # Eager load
    )
    
    result = await db.execute(query)
    return result.scalar_one_or_none()

# WRONG: Lazy loading (causes N+1 queries)
async def bad_get_indicators(db: AsyncSession):
    result = await db.execute(select(Indicator))
    indicators = result.scalars().all()
    
    # Each access to indicator.values causes a query!
    for indicator in indicators:
        print(indicator.values)  # N+1 problem
```


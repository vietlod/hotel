@pytest.mark.asyncio
async def test_export_to_csv():
    """Test CSV export functionality."""
    service = ExportService()
    
    test_data = [
        IndicatorResponse(
            id="WB_001",
            name="GDP",
            source="WB",
            frequency="annual",
            values=[{"year": 2023, "value": 100.5}]
        )
    ]
    
    # CSV export should return bytes
    result = service.to_csv(test_data)
